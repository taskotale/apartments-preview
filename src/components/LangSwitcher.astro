---
import { languages } from '../data/sites';

interface Props { current?: string }
const { current = 'en' } = Astro.props;

const flags = import.meta.glob<{ default: string }>('../assets/flags/*.svg', {
  eager: true,
  query: '?url',
});
const flagUrl = (code: string) => flags[`../assets/flags/${code}.svg`]?.default ?? '';
const active = languages.find((l) => l.code === current) ?? languages[0];
---
<details class="lang">
  <summary aria-label="Choose language">
    <img class="flag" src={flagUrl(active.flag)} alt="" width="16" height="16" />
    {active.code.toUpperCase()}
  </summary>
  <div class="lang-menu">
    {languages.map((l) => (
      <a href={l.code === current ? '#' : '#'} aria-current={l.code === current ? 'true' : undefined} title={l.code === current ? undefined : 'Live after launch'}>
        <img class="flag" src={flagUrl(l.flag)} alt="" width="18" height="18" loading="lazy" />
        {l.name}
      </a>
    ))}
  </div>
</details>
<script>
  // Close the dropdown when clicking anywhere else.
  document.querySelectorAll<HTMLDetailsElement>('details.lang').forEach((d) => {
    document.addEventListener('click', (e) => {
      if (d.open && !d.contains(e.target as Node)) d.open = false;
    });
  });
</script>
