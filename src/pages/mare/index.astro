---
import '@fontsource-variable/fraunces';
import '../../styles/theme-mare.css';
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import OnePager from '../../components/OnePager.astro';
import { mare } from '../../data/sites';

const mods = import.meta.glob<{ default: ImageMetadata }>('../../assets/photos/mare/*.jpg', { eager: true });
const photos = Object.fromEntries(Object.entries(mods).map(([p, m]) => [p.split('/').pop()!, m.default]));
const og = await getImage({ src: photos[mare.heroFile], width: 1200, height: 630, fit: 'cover', format: 'jpeg' });
---
<Base
  title="Mare e Monti — apartment in Bar, Montenegro"
  description={mare.metaDescription}
  themeClass={mare.theme}
  favicon={mare.favicon}
  ogImage={og.src}
  noindex
>
  <OnePager site={mare} photos={photos} />
</Base>
