---
import '@fontsource-variable/nunito';
import '../../styles/theme-dolce.css';
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import OnePager from '../../components/OnePager.astro';
import { dolce } from '../../data/sites';

const mods = import.meta.glob<{ default: ImageMetadata }>('../../assets/photos/dolce/*.jpg', { eager: true });
const photos = Object.fromEntries(Object.entries(mods).map(([p, m]) => [p.split('/').pop()!, m.default]));
const og = await getImage({ src: photos[dolce.heroFile], width: 1200, height: 630, fit: 'cover', format: 'jpeg' });
---
<Base
  title="Dolce dimora — apartment in Bar, Montenegro"
  description={dolce.metaDescription}
  themeClass={dolce.theme}
  favicon={dolce.favicon}
  ogImage={og.src}
  noindex
>
  <OnePager site={dolce} photos={photos} />
</Base>
