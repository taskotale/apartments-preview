---
// Both fonts and both themes are declared here, but a visitor only downloads the
// font their own site actually renders with (@font-face is lazy), and the theme
// CSS is scoped by class. This keeps one codebase serving both sites.
import '@fontsource-variable/fraunces';
import '@fontsource-variable/nunito';
import '../styles/theme-mare.css';
import '../styles/theme-dolce.css';

import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import OnePager from '../components/OnePager.astro';
import { mare, dolce } from '../data/sites';

const which = process.env.APT_SITE === 'dolce' ? 'dolce' : 'mare';
const site = which === 'dolce' ? dolce : mare;

const mareMods = import.meta.glob<{ default: ImageMetadata }>('../assets/photos/mare/*.jpg', { eager: true });
const dolceMods = import.meta.glob<{ default: ImageMetadata }>('../assets/photos/dolce/*.jpg', { eager: true });
const mods = which === 'dolce' ? dolceMods : mareMods;
const photos = Object.fromEntries(Object.entries(mods).map(([p, m]) => [p.split('/').pop()!, m.default]));

const og = await getImage({ src: photos[site.heroFile], width: 1200, height: 630, fit: 'cover', format: 'jpeg' });
---
<Base
  title={`${site.name} — apartment in Bar, Montenegro`}
  description={site.metaDescription}
  themeClass={site.theme}
  favicon={site.favicon}
  ogImage={og.src}
>
  <OnePager site={site} photos={photos} />
</Base>
