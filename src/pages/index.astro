---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';

const mareMods = import.meta.glob<{ default: ImageMetadata }>('../assets/photos/mare/*.jpg', { eager: true });
const dolceMods = import.meta.glob<{ default: ImageMetadata }>('../assets/photos/dolce/*.jpg', { eager: true });
const mareHero = Object.entries(mareMods).find(([p]) => p.endsWith('hero-sunset.jpg'))![1].default;
const dolceHero = Object.entries(dolceMods).find(([p]) => p.endsWith('hero-sunset-sea.jpg'))![1].default;
---
<Base
  title="Two apartments in Bar — design preview"
  description="Design preview: Mare e Monti and Dolce dimora, two family apartments in Bar, Montenegro."
  themeClass=""
  favicon="🏠"
  noindex
>
  <style>
    body { background: #14181f; color: #f2efe8; min-height: 100svh; display: grid; place-content: center; padding: 2rem; }
    h1 { font-size: clamp(1.5rem, 4vw, 2.2rem); text-align: center; margin-bottom: .4rem; font-family: Georgia, serif; }
    p.sub { text-align: center; opacity: .7; margin-bottom: 2.2rem; }
    .pick { display: grid; gap: 1.4rem; grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr)); max-width: 52rem; }
    .pick a { position: relative; display: block; border-radius: 18px; overflow: hidden; text-decoration: none; color: #fff; aspect-ratio: 16/10; box-shadow: 0 24px 60px -24px rgb(0 0 0 / .8); transition: transform .2s ease; }
    .pick a:hover { transform: translateY(-4px); }
    .pick img { width: 100%; height: 100%; object-fit: cover; }
    .pick span { position: absolute; inset: auto 0 0 0; padding: 2.4rem 1.3rem 1.1rem; background: linear-gradient(transparent, rgb(0 0 0 / .78)); font-size: 1.25rem; font-weight: 700; }
    .pick small { display: block; font-weight: 400; opacity: .8; font-size: .85rem; }
  </style>
  <h1>Two apartments, two personalities</h1>
  <p class="sub">Design preview — open each and tell me what to keep, change, or mix.</p>
  <div class="pick">
    <a href="mare/">
      <Image src={mareHero} alt="" width={760} />
      <span>Mare e Monti <small>romantic-Italian · navy, sunset amber, retro serif</small></span>
    </a>
    <a href="dolce/">
      <Image src={dolceHero} alt="" width={760} />
      <span>Dolce dimora <small>playful sweet-home · cream, emerald, pink</small></span>
    </a>
  </div>
</Base>
